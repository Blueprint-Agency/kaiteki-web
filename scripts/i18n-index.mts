// Regenerate content/i18n/<kind>/index.ts for every kind from the translation
// files on disk.
//
//   node --experimental-strip-types scripts/i18n-index.mts
//
// Translations are bundled through static imports rather than read with fs at
// render time, so the bundler tracks them (hot reload in dev, no filesystem
// access when a page renders). validate-locale (L-09) fails when an index is
// out of date.

import { existsSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { KINDS, LOCALES, type Kind } from "./i18n-kinds.mts";

const id = (l: string, slug: string) => `${l}_${slug.replace(/-/g, "_")}`;

for (const kind of Object.keys(KINDS) as Kind[]) {
  const root = join(process.cwd(), "content", "i18n", kind);
  const files = Object.fromEntries(
    LOCALES.map((l) => [
      l,
      existsSync(join(root, l))
        ? readdirSync(join(root, l)).filter((f) => f.endsWith(".json")).map((f) => f.slice(0, -5)).sort()
        : [],
    ]),
  ) as Record<(typeof LOCALES)[number], string[]>;

  const lines = [
    "// GENERATED by scripts/i18n-index.mts. Do not edit: run `pnpm i18n:index`.",
    "",
    ...LOCALES.flatMap((l) => files[l].map((s) => `import ${id(l, s)} from "./${l}/${s}.json";`)),
    "",
    "export const translations: Record<\"zh\" | \"ms\", Record<string, unknown>> = {",
    ...LOCALES.map((l) => `  ${l}: {\n${files[l].map((s) => `    "${s}": ${id(l, s)},`).join("\n")}\n  },`),
    "};",
    "",
  ];
  writeFileSync(join(root, "index.ts"), lines.join("\n"));
  console.log(`${kind}/index.ts: ${files.zh.length} zh, ${files.ms.length} ms`);
}
