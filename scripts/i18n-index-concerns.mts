// Regenerate content/i18n/concerns/index.ts from the translation files on disk.
//
//   node --experimental-strip-types scripts/i18n-index-concerns.mts
//
// Translations are bundled through static imports rather than read with fs at
// render time, so the bundler tracks them (hot reload in dev, no filesystem
// access when a page renders). validate-locale (L-09) fails when this index
// is out of date.

import { readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const root = join(process.cwd(), "content", "i18n", "concerns");
const locales = ["zh", "ms"] as const;
const id = (l: string, slug: string) => `${l}_${slug.replace(/-/g, "_")}`;

const files = Object.fromEntries(
  locales.map((l) => [l, readdirSync(join(root, l)).filter((f) => f.endsWith(".json")).map((f) => f.slice(0, -5)).sort()]),
) as Record<(typeof locales)[number], string[]>;

const lines = [
  "// GENERATED by scripts/i18n-index-concerns.mts. Do not edit: run `pnpm i18n:index`.",
  "",
  ...locales.flatMap((l) => files[l].map((s) => `import ${id(l, s)} from "./${l}/${s}.json";`)),
  "",
  "export const concernTranslations: Record<\"zh\" | \"ms\", Record<string, unknown>> = {",
  ...locales.map((l) => `  ${l}: {\n${files[l].map((s) => `    "${s}": ${id(l, s)},`).join("\n")}\n  },`),
  "};",
  "",
];
writeFileSync(join(root, "index.ts"), lines.join("\n"));
console.log(`index.ts: ${files.zh.length} zh, ${files.ms.length} ms`);
