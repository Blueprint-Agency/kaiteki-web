#!/usr/bin/env node
/**
 * The 301 map that retires blog.kaiteki.my.
 *
 * HISTORICAL since 2026-10-31. WordPress is gone, so this can no longer run.
 * The live map is config/blog-host-redirects.json, served by proxy.ts on
 * Vercel. Edit that JSON by hand; the nginx container below no longer exists.
 *
 *   pnpm blog:redirects                > blog-redirects.conf   # nginx
 *   pnpm blog:redirects --format=csv   > blog-redirects.csv    # from,to,status (for checking)
 *
 * These rules run on the BLOG HOST, not in next.config.ts: Next can only
 * redirect hosts it serves. The nginx output is the whole server config for
 * the tiny container that replaces WordPress on bpvps1 (infrastructure repo,
 * vps/bpvps1/stacks/blog-redirect/). Regenerate and copy it there.
 *
 * Every legacy URL is accounted for:
 *   - each post's `legacyPath` (content/data/blog.ts)  → /blog/<slug>
 *   - renamed slugs posts still link to                → the post that took the name
 *   - the 51 doorway pages                             → their branch page
 *   - other WP pages, Malay posts                      → /blog
 *   - category archives                                → /blog/category/<ours>
 *   - every image the migration moved                  → its cdn.kaiteki.my copy
 *   - injected spam                                    → 410 Gone
 *   - anything else (home, feeds, authors, ?p=…)       → /blog
 *
 * Needs the old WordPress API up (it lists the pages and categories), so run it
 * BEFORE WordPress is switched off. The output is committed in infrastructure.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { posts } from "../content/data/blog.ts";
import {
  CATEGORIES,
  MALAY,
  RENAMED,
  SITE,
  SPAM,
  categorySlug,
  doorwayDestination,
} from "./blog-redirect-rules.mjs";

const ROOT = process.cwd();
const API = "https://blog.kaiteki.my/wp-json/wp/v2";
const UA = { "User-Agent": "Mozilla/5.0 (kaiteki-blog-redirects)" };

async function fetchAll(resource: string, fields: string): Promise<Record<string, string>[]> {
  const out: Record<string, string>[] = [];
  for (let page = 1; ; page += 1) {
    const res = await fetch(`${API}/${resource}?per_page=100&page=${page}&_fields=${fields}`, { headers: UA });
    if (!res.ok) throw new Error(`${res.status} ${resource}: is the old WordPress still up?`);
    const batch = await res.json();
    out.push(...batch);
    if (batch.length < 100) return out;
  }
}

const [pages, cats] = await Promise.all([fetchAll("pages", "slug"), fetchAll("categories", "slug")]);
const media: Record<string, string> = JSON.parse(
  readFileSync(join(ROOT, "scripts", "blog-legacy-media.json"), "utf8"),
);

type Rule = { from: string; to: string | null; status: 301 | 410 };
const rules: Rule[] = [];
const seen = new Set<string>();
const add = (from: string, to: string | null, status: 301 | 410 = 301) => {
  if (seen.has(from)) return;
  seen.add(from);
  rules.push({ from, to: to && to.startsWith("/") ? `${SITE}${to}` : to, status });
};

for (const s of SPAM) add(`/${s}/`, null, 410);

for (const p of posts) if (p.legacyPath) add(p.legacyPath, `/blog/${p.slug}`);

const postSlugs = new Set(posts.map((p) => p.slug));
for (const [from, to] of Object.entries(RENAMED)) {
  if (!postSlugs.has(to)) throw new Error(`RENAMED ${from} → ${to}: no such post`);
  add(`/${from}/`, `/blog/${to}`);
}

for (const s of MALAY) add(`/${s}/`, "/blog");
for (const { slug } of pages) add(`/${slug}/`, doorwayDestination(slug));

for (const { slug } of cats) {
  const cat = (CATEGORIES as Record<string, string>)[slug];
  add(`/category/${slug}/`, cat ? `/blog/category/${categorySlug(cat)}` : "/blog");
}

for (const [from, to] of Object.entries(media)) add(new URL(from).pathname, to);

// ── output ──────────────────────────────────────────────────────────────────
const fmt = (process.argv.find((a) => a.startsWith("--format=")) ?? "--format=nginx").split("=")[1];

if (fmt === "csv") {
  console.log("from,to,status");
  for (const r of rules) console.log(`${r.from},${r.to ?? ""},${r.status}`);
} else {
  // nginx matches $uri decoded, so keys are decoded too; quoting covers spaces.
  const q = (s: string) => `"${decodeURIComponent(s).replace(/(["\\])/g, "\\$1")}"`;
  const lines = [
    "# blog.kaiteki.my -> kaiteki.my. GENERATED by kaiteki-web scripts/blog-redirects.mts;",
    "# regenerate there rather than editing by hand.",
    "",
    "# The legacy slugs and image paths are long; the default bucket (64) cannot hold them.",
    "map_hash_bucket_size 256;",
    "map_hash_max_size 4096;",
    "",
    "map $uri $blog_target {",
    "    default \"\";",
  ];
  for (const r of rules.filter((x) => x.status === 301)) {
    lines.push(`    ${q(r.from)} ${q(r.to!)};`);
    // Same page without the trailing slash.
    if (r.from.endsWith("/") && r.from !== "/") lines.push(`    ${q(r.from.slice(0, -1))} ${q(r.to!)};`);
  }
  lines.push("}", "");
  lines.push("map $uri $blog_gone {", "    default 0;");
  for (const r of rules.filter((x) => x.status === 410)) {
    lines.push(`    ${q(r.from)} 1;`, `    ${q(r.from.slice(0, -1))} 1;`);
  }
  lines.push("}", "");
  lines.push(
    "server {",
    "    listen 80 default_server;",
    "    server_name _;",
    "",
    "    # Traefik terminates TLS; this answers plain HTTP behind it.",
    "    location = /healthz { access_log off; return 200 \"ok\\n\"; }",
    "",
    "    location / {",
    "        if ($blog_gone) { return 410; }",
    "        if ($blog_target != \"\") { return 301 $blog_target; }",
    "        # Images the migration did not move are gone with WordPress.",
    "        if ($uri ~ ^/wp-content/) { return 410; }",
    `        return 301 ${SITE}/blog;`,
    "    }",
    "}",
  );
  console.log(lines.join("\n"));
}

const n = (s: number) => rules.filter((r) => r.status === s).length;
console.error(`# ${rules.length} rules: ${n(301)} redirects, ${n(410)} gone; everything else -> ${SITE}/blog`);
