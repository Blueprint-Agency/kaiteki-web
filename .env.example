# Copy to .env.local. No secrets belong in the repo.

# Staging guard. A canonical to kaiteki.my does NOT stop Google indexing a
# staging host — set this on every non-production deploy (spec bug B-08).
NEXT_PUBLIC_NOINDEX=1

# Compliance (spec bug B-02). BOTH must be set before the site can be indexed:
# while either is missing, lib/seo.ts forces noindex site-wide and /robots.txt
# serves Disallow: /. Website content for aesthetic services is advertising
# under Malaysian rules and cannot be public with a placeholder approval number.
# NEXT_PUBLIC_KKLIU=KKLIU 1234/2026
# NEXT_PUBLIC_COMPANY_NO=Co. No. 201501000000 (1234567-A)
