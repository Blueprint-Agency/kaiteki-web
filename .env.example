# Copy to .env.local. Docs: docs/13 §"Sync", content/blog/AUTHORING.md §3.

# Set on non-production deploys only (staging guard, spec bug B-08).
NEXT_PUBLIC_NOINDEX=1

# Cloudflare R2 upload creds — tooling/CI only, the site never reads them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kaiteki-web-prod

# Local folder of the designer's media export (not in repo).
MEDIA_SOURCE=/Users/you/path/to/media-export
