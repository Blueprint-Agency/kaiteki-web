# Copy to .env.local. No secrets belong in the repo.

# Staging guard. A canonical to kaiteki.my does NOT stop Google indexing a
# staging host — set this on every non-production deploy (spec bug B-08).
# It is inlined at build time, so it must be passed as a Docker build arg
# (deploy-staging.yml does this), not set in compose at runtime.
NEXT_PUBLIC_NOINDEX=1

# Cloudflare R2 — the only home for blog media (content/blog/AUTHORING.md §3).
# Tooling-only: the site never reads these, and no author needs them. The upload
# is the deploy workflows' `aws s3 sync` step, which reads them from the repo's
# GitHub secrets (R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) and variables
# (R2_ACCOUNT_ID, R2_BUCKET_NAME). Set them locally only to poke at the bucket
# by hand. Scope the token to Object Read & Write on this one bucket.
# Names match booking-system's so one set of habits covers both.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kaiteki-web-prod
# The public host the bucket serves on. Change it and two constants must change
# to match: images.remotePatterns in next.config.ts, and R2_HOST in
# scripts/check-blog.mts.
R2_PUBLIC_URL=https://cdn.kaiteki.my

# The company number is hardcoded in lib/site.ts. There is no KKLIU env var:
# no advertisement approval ref was ever issued, so the footer shows none
# rather than a placeholder (see lib/seo.ts for how to re-gate if one arrives).
