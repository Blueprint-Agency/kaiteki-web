{
  "name": "kaiteki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:refs": "node --experimental-strip-types scripts/validate-content.mts",
    "validate:concerns": "node --experimental-strip-types scripts/validate-concerns.mts",
    "test:redirects": "node --experimental-strip-types scripts/test-redirects.mts",
    "check:blog": "node --experimental-strip-types scripts/check-blog.mts",
    "validate:locale": "node --experimental-strip-types scripts/validate-locale.mts",
    "i18n:sync": "node --experimental-strip-types scripts/i18n-sync.mts",
    "i18n:index": "node --experimental-strip-types scripts/i18n-index.mts",
    "i18n:export": "node --experimental-strip-types scripts/i18n-export.mts",
    "check:sameness": "node --experimental-strip-types scripts/check-sameness.mts",
    "check:cost": "node --experimental-strip-types scripts/check-cost-factors.mts",
    "check:links": "node --experimental-strip-types scripts/check-links.mts",
    "audit:concern-media": "node --env-file-if-exists=.env.local scripts/media-audit.mjs concerns",
    "sync:concern-media": "node --env-file-if-exists=.env.local scripts/sync-media.mjs concerns",
    "audit:treatment-media": "node --env-file-if-exists=.env.local scripts/media-audit.mjs treatments",
    "sync:treatment-media": "node --env-file-if-exists=.env.local scripts/sync-media.mjs treatments",
    "blog:manifest": "node scripts/blog-import.mjs --manifest",
    "blog:import": "node scripts/blog-import.mjs",
    "blog:migrate-legacy": "node scripts/blog-migrate-legacy.mjs",
    "blog:redirects": "node --experimental-strip-types --no-warnings scripts/blog-redirects.mts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@next/third-parties": "16.2.10",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "//browserslist": "Drops Next's legacy polyfill chunk (~13.5 KiB): Array.at/flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/trimEnd. Widen if analytics ever shows meaningful old-browser traffic.",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  }
}
