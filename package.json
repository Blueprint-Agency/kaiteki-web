{
  "name": "kaiteki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:refs": "node --experimental-strip-types scripts/validate-content.mts",
    "validate:concerns": "node --experimental-strip-types scripts/validate-concerns.mts",
    "test:redirects": "node --experimental-strip-types scripts/test-redirects.mts",
    "check:blog": "node --experimental-strip-types scripts/check-blog.mts",
    "audit:concern-media": "node --env-file-if-exists=.env.local scripts/audit-concern-media.mjs",
    "sync:concern-media": "node --env-file-if-exists=.env.local scripts/sync-concern-media.mjs",
    "blog:manifest": "node scripts/blog-import.mjs --manifest",
    "blog:import": "node scripts/blog-import.mjs",
    "blog:redirects": "node scripts/blog-redirects.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@next/third-parties": "16.2.10",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "//browserslist": "Drops Next's legacy polyfill chunk (~13.5 KiB): Array.at/flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/trimEnd. Widen if analytics ever shows meaningful old-browser traffic.",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  }
}
